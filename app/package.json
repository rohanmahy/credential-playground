{
  "name": "tokenator-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/tokenator-wasm --target web --profile wasm-release --no-opt --no-pack",
    "build:wasm:debug": "wasm-pack build ../crates/tokenator-wasm --target web --dev --no-pack",
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && pnpm typecheck:e2e-desktop",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wasm": "pnpm build:wasm && vitest run --config vitest.wasm.config.ts",
    "test:parity": "pnpm build:wasm && vitest run --config vitest.wasm.config.ts src/test/wasm/parity.test.ts",
    "parity:regen": "cargo run --release --locked -p parity -- regen",
    "parity:check": "cargo run --release --locked -p parity -- check",
    "test:e2e": "playwright test",
    "build:desktop-e2e": "node e2e-desktop/build.mjs",
    "test:e2e:desktop": "wdio run e2e-desktop/wdio.conf.ts",
    "typecheck:e2e-desktop": "tsc -p e2e-desktop/tsconfig.json",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "tauri": "cargo tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
