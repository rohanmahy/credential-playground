{
  "$schema": "./gen/schemas/config.schema.json",
  "productName": "The Tokenator",
  "mainBinaryName": "tokenator",
  "identifier": "io.github.rohanmahy.tokenator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "The Tokenator",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "incognito": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "worker-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "A credential playground for JWT, SD-JWT, CWT, and SD-CWT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
