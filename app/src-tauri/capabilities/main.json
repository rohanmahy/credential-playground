{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the engine and platform commands, nothing else. No core, dialog, clipboard, fs, shell, or http permissions: dialogs and the clipboard are driven from Rust.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-engine-init",
    "allow-engine-info",
    "allow-engine-detect",
    "allow-engine-open",
    "allow-engine-render",
    "allow-engine-parse-edit",
    "allow-engine-issue",
    "allow-engine-redact",
    "allow-engine-disclose",
    "allow-engine-present",
    "allow-engine-validate",
    "allow-engine-lint",
    "allow-engine-resign",
    "allow-engine-tamper",
    "allow-engine-reencode",
    "allow-engine-edit-disclosures",
    "allow-engine-decode-embedded",
    "allow-engine-key-import",
    "allow-engine-key-export",
    "allow-engine-key-public",
    "allow-engine-key-generate",
    "allow-engine-key-thumbprint",
    "allow-engine-key-assign-kid",
    "allow-engine-key-to-jwk",
    "allow-engine-key-to-cwk",
    "allow-engine-datetime",
    "allow-engine-registry-lookup",
    "allow-engine-registry-merge",
    "allow-fetch-url",
    "allow-open-file",
    "allow-save-file",
    "allow-read-clipboard",
    "allow-write-clipboard",
    "allow-registry-cache-get",
    "allow-registry-cache-put",
    "allow-registry-cache-clear"
  ]
}
